---
// src/pages/products/index.astro
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";
import { categories } from "../../data/products";

// 전체 제품 가져오기
const allProducts = await getCollection("products");
const categoryKeys = Object.keys(categories);

// 카테고리별로 제품 그룹화 및 우선순위 정렬
const groupedProducts = categoryKeys.map((catKey) => {
  const prods = allProducts
    .filter((p) => p.data.category === catKey && p.data.priority >= 0)
    .map((p) => ({ ...p.data, id: p.id }))
    .sort((a, b) => b.priority - a.priority);
    
  return {
    name: catKey,
    data: categories[catKey],
    products: prods,
  };
}).filter(group => group.products.length > 0); // 제품이 있는 카테고리만 렌더링

// SEO 데이터
const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: allProducts.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(`/products/${product.id}`, Astro.site).href,
    name: product.data.name,
  })),
};
---

<Layout
  title="제이원텍(주) | 제품 소개"
  description="제이원텍(주) 제품 소개"
  structuredData={listSchema}
>
  <div class="container mx-auto px-4 py-16" id="top">
    <!-- Hero Section -->
    <div class="text-center mb-12">
      <div
        class="inline-block px-4 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium mb-4"
      >
        PRODUCTS
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Products</h1>
      <p class="text-base-content/60 max-w-2xl mx-auto">
        산업 현장의 안전과 효율을 위한 최고의 솔루션을 제공합니다
      </p>
    </div>

    <div class="sticky top-0 z-40 bg-base-100/95 backdrop-blur-md py-4 mb-16 border-b border-base-200 shadow-sm flex flex-wrap justify-center items-center gap-2 md:gap-3 transition-all w-full">
      {
        groupedProducts.map((group, idx) => (
          <a
            href={`#section-${idx}`}
            class="btn btn-sm md:btn-md btn-outline border-base-300 hover:border-primary hover:bg-primary/10 hover:text-primary rounded-full font-medium transition-all bg-base-100"
          >
            <!-- 영문 괄호를 제외하고 한글 카테고리명만 표시 -->
            {group.name.split(' (')[0]}
          </a>
        ))
      }
    </div>

    <div class="space-y-24">
      {
        groupedProducts.map((group, idx) => (
          <section id={`section-${idx}`} class="scroll-mt-24">
            <!-- 섹션 타이틀 -->
            <div class="mb-6 border-b-2 border-base-200 pb-3">
              <h2 class="text-3xl md:text-4xl font-bold text-base-content mb-2 pl-2">
                {group.name}
              </h2>
              <p class="text-base-content/60 pl-2">{group.data.description}</p>
            </div>

            <!-- 제품 그리드 -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {group.products.map((product) => (
                <ProductCard
                  id={product.id}
                  name={product.name}
                  summary={product.summary}
                  image={product.image}
                  category={product.category}
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>
    
    <!-- 제품이 없을 경우 -->
    {
      groupedProducts.length === 0 && (
        <div class="text-center py-16">
          <p class="text-base-content/50">등록된 제품이 없습니다.</p>
        </div>
      )
    }
  </div>
</Layout>

<style>
  /* 부드러운 스크롤 애니메이션 필수 */
  html {
    scroll-behavior: smooth;
  }
</style>