---
// src/pages/qr-info.astro
import Layout from "../layouts/Layout.astro";

// 첨부파일 목록
const attachments = [
  {
    filename: "분진 폭발 방지 시스템 브로셔",
    fileUrl: "https://attachments.jonetec.co.kr/IEP/IEP_%EC%A0%9C%ED%92%88_%EB%B8%8C%EB%A1%9C%EC%85%94.pdf",
  },
  {
    filename: "분진 폭발 방지 시스템 소개 PT자료",
    fileUrl: "https://attachments.jonetec.co.kr/IEP/Introduction_to_IEP_Safety_%EC%A0%9C%EC%9D%B4%EC%9B%90%ED%85%8D_2022.pdf",
  },
  {
    filename: "폭발억제장치의 설치에 관한 기술지침 - KOSHA Guide",
    fileUrl: "https://attachments.jonetec.co.kr/IEP/D-16-2012_%ED%8F%AD%EB%B0%9C%EC%96%B5%EC%A0%9C%EC%9E%A5%EC%B9%98%EC%9D%98_%EC%84%A4%EC%B9%98_%EA%B8%B0%EC%88%A0%EC%A7%80%EC%B9%A8.pdf",
  },
];
---

<Layout
  title="제이원텍(주) | 분진 폭발 방지 솔루션"
  description="가연성 분진과 하이브리드 분진에 의한 폭발을 완화, 차단 및 억제하는 종합 안전 시스템 안내"
  image="/images/products/iep-thumbnail.png"
>
  <div class="container mx-auto px-4 py-12 md:py-16 max-w-4xl">
    <!-- 상단 타이틀 영역 -->
    <div class="text-center mb-12">
      <div
        class="inline-block px-4 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium mb-4"
      >
        안전 솔루션
      </div>
      <h1 class="text-3xl md:text-5xl font-bold mb-4 break-keep leading-tight">
        <span class="text-primary">분진 폭발 방지</span> 솔루션
      </h1>
      <p class="text-base-content/60 max-w-2xl mx-auto break-keep">
        공정 내 가연성 및 하이브리드 분진으로 인한 폭발 위험을 예방하고, 폭발 발생 시 설비와 인명을 보호하기 위한 핵심 방호 기술을 안내합니다.
      </p>
    </div>

    <!-- 1. 분진폭발이란? (단독 카드) -->
    <div class="card bg-base-100 shadow-xl border border-base-300 overflow-hidden mb-10">
      <div class="card-body p-6 md:p-10">
        <h2 class="text-xl md:text-3xl font-bold mb-4">분진 폭발이란?</h2>
        <p class="text-base-content/80 text-lg leading-relaxed break-keep mb-6">
          일반적인 화재가 발생하는 필수 3요소인 <strong>산소, 열, 가연물</strong>의 조합에 더해, 분진이 공기 중에 일정 농도로 흩날리는 <strong>부유 상태</strong>와 설비 내부라는 <strong>밀폐·가둠 상태</strong>가 추가될 때 급격한 압력 상승과 화염을 동반한 분진 폭발이 발생합니다.
        </p>

        <!-- 연소와 폭발의 차이 이미지 (회색 배경 제거됨) -->
        <figure class="mt-2 p-2 flex flex-col items-center">
          <img
            src="/images/products/iep-explosion.png"
            alt="연소와 폭발의 차이"
            class="mx-auto rounded-lg max-h-80 object-contain"
          />
          <figcaption class="mt-3 text-sm font-medium text-base-content/70 text-center">
            연소와 폭발의 차이
          </figcaption>
        </figure>
      </div>
    </div>

    <!-- 2. 분진 폭발 방지 시스템 (전체 하나의 카드로 통합 & 하위 카드 제거) -->
    <div class="card bg-base-100 shadow-xl border border-base-300 overflow-hidden mb-10">
      <div class="card-body p-6 md:p-10">
        <!-- 섹션 헤더 -->
        <div class="mb-6 pb-6 border-b border-base-200">
          <h2 class="text-xl md:text-3xl font-bold mb-4">분진 폭발 방지 시스템</h2>
          <p class="text-base-content/80 text-lg leading-relaxed break-keep">
            폭발 직전에 감지하여 진압하며, 폭발 발생 시에는 이를 안전하게 방출하고 추가 확산을 차단하는 종합 방호 체계입니다. 가연성 분진 및 고체 미립자를 취급하는 집진기, 사이클론, 건조기, 사일로 및 이송 배관 등 모든 공정에 적용됩니다.
          </p>
        </div>

        <!-- 하위 섹션 목록 (카드 없이 구분선으로만 연결) -->
        <div class="divide-y divide-base-200">
          <!-- 하위 1: 폭발 방출 -->
          <div class="py-6 first:pt-2 flex flex-col md:flex-row gap-6 items-center">
            <div class="w-full md:w-1/3 shrink-0 flex items-center justify-center">
              <img
                src="/images/products/iep-explosion-vent.png"
                alt="폭발 방출 시스템"
                class="rounded-lg max-h-44 w-auto object-contain"
              />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold mb-2">
                폭발 방출 시스템
              </h3>
              <p class="text-base-content/80 text-base leading-relaxed break-keep">
                설비 내부 압력이 설정된 한계치에 도달하면 파열판이 개방되어 화구와 폭발성 압력을 안전한 외부 지역으로 방출시킵니다. 옥내 설치 등으로 외부 방출이 불가할 시에는 <strong>무화염 방출 시스템</strong>을 통해 화염을 진화하고 압력을 안전하게 경감시킵니다.
              </p>
            </div>
          </div>

          <!-- 하위 2: 폭발 차단 -->
          <div class="py-6 flex flex-col md:flex-row gap-6 items-center">
            <div class="w-full md:w-1/3 shrink-0 flex items-center justify-center">
              <img
                src="/images/products/iep-isolation.png"
                alt="폭발 차단 시스템"
                class="rounded-lg max-h-44 w-auto object-contain"
              />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold mb-2">
                폭발 차단 시스템
              </h3>
              <p class="text-base-content/80 text-base leading-relaxed break-keep">
                공정 내에 상호 연결된 설비 및 배관 사이로 화염과 폭연이 이동하여 발생하는 치명적인 2차 연쇄 폭발 위험을 물리적·화학적으로 즉시 차단하는 장치입니다.
              </p>
            </div>
          </div>

          <!-- 하위 3: 폭발 억제 -->
          <div class="py-6 last:pb-0 flex flex-col md:flex-row gap-6 items-center">
            <div class="w-full md:w-1/3 shrink-0 flex items-center justify-center">
              <img
                src="/images/products/iep-suppressor.png"
                alt="폭발 억제 시스템"
                class="rounded-lg max-h-44 w-auto object-contain"
              />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold mb-2">
                폭발 억제 시스템
              </h3>
              <p class="text-base-content/80 text-base leading-relaxed break-keep">
                폭발 초기 압력이 발생하는 것을 아주 짧은 순간에 감지하고, 설비가 파괴 압력에 도달하기 전에 밀폐 공간 내부로 폭발 진압제를 고속 분사하여 화염을 초기에 소멸시키는 능동형 시스템입니다.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. 기술 자료 다운로드 섹션 -->
    <div class="card bg-base-200/70 border border-base-300 shadow-sm">
      <div class="card-body p-6 md:p-8">
        <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"
            />
          </svg>
          관련 기술 자료 다운로드
        </h3>
        <div class="grid grid-cols-1 gap-3">
          {attachments.map((file) => (
            <a
              href={file.fileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 p-4 bg-base-100 rounded-xl border border-base-300 hover:border-primary hover:shadow-md transition-all duration-200"
            >
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm md:text-base font-semibold text-base-content truncate group-hover:text-primary transition-colors">
                  {file.filename}
                </p>
                <p class="text-xs text-base-content/50">클릭하여 파일 열기 및 다운로드</p>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-base-content/30 group-hover:text-primary group-hover:translate-y-0.5 transition-all shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>